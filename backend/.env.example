DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://coupon_platform:coupon_platform@localhost:5433/coupon_platform
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# TCB (The Coupon Bureau) platform-level credentials — one pair per role we
# register as. See backend/tcb_integration/ and the plan's "TCB integration
# seam" section. Never commit real values.
TCB_API_BASE_URL=https://api.portal.thecouponbureau.org
TCB_AUTHORIZED_PARTNER_ACCESS_KEY=
TCB_AUTHORIZED_PARTNER_SECRET_KEY=
TCB_PROVIDER_ACCESS_KEY=
TCB_PROVIDER_SECRET_KEY=
TCB_PLATFORM_EMAIL_DOMAIN=example.com
# Set to False once real credentials above are provisioned — until then,
# every TCB call is served by tcb_integration/mock_client.py.
TCB_USE_MOCK=True

# Google Wallet — platform-level Issuer, ported from server.js's hardcoded
# ISSUER_ID/ISSUER_NAME/keys/wallet-sa.json. See wallet/service.py.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_ISSUER_NAME=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=keys/wallet-sa.json

# Google/Microsoft OAuth SSO — configured via django-allauth SocialApp
# records (Django admin) rather than settings.py in production; these are
# only here as a reminder of what's needed for local dev.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
